# Copy to .env for local development. Never commit real values.

# development | production. Production refuses PAP_AUTH_MODE=dev.
PAP_ENV=development

# PostgreSQL (SQLAlchemy URL, psycopg 3 driver)
PAP_DATABASE_URL=postgresql+psycopg://pap:change-me@localhost:5432/pap

# Authentication: oidc | dev
PAP_AUTH_MODE=dev
PAP_OIDC_ISSUER=https://idp.example.com/realms/pap
PAP_OIDC_AUDIENCE=pap-api
# Optional; defaults to <issuer>/protocol/openid-connect/certs discovery via .well-known
PAP_OIDC_JWKS_URL=

# Web sign-in (the Next.js server; AUTH-002). dev = the labelled development identity, refused when
# PAP_ENV=production; oidc = authorization code + PKCE, tokens kept server-side in a sealed HttpOnly cookie.
PAP_WEB_AUTH=dev
# PAP_OIDC_ISSUER is shared with the API above.
PAP_OIDC_CLIENT_ID=pap-web
# Only for a confidential client; leave empty for a public client (PKCE).
PAP_OIDC_CLIENT_SECRET=
# Resource indicator (RFC 8707) so access tokens carry the API audience; usually equal to PAP_OIDC_AUDIENCE.
PAP_OIDC_RESOURCE=
PAP_OIDC_SCOPE=openid profile email
# The public origin of the web app; the redirect URI is <origin>/auth/callback.
PAP_WEB_ORIGIN=http://127.0.0.1:3000
# 32+ random characters; changing it signs everyone out.
PAP_SESSION_SECRET=

# Artifact storage: local | s3
PAP_STORAGE_BACKEND=local
PAP_STORAGE_PATH=./var/artifacts
# S3-compatible storage (PAP_STORAGE_BACKEND=s3). Credentials from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or the
# instance role. Endpoint unset = AWS S3; set it for SeaweedFS, MinIO, Ceph RGW, Cloudflare R2, ...
PAP_S3_BUCKET=
PAP_S3_PREFIX=
PAP_S3_ENDPOINT_URL=
PAP_S3_REGION=us-east-1
PAP_S3_PATH_STYLE=true
PAP_MAX_UPLOAD_BYTES=104857600

# Pinned engine (see engine.lock.json, scripts/build-openmhs.sh)
OPENMHS_BIN=./.engine/bin/openmhs
OPENMHS_BIN_SHA256=
PAP_ENGINE_TIMEOUT_S=300

# Worker
PAP_WORKER_LEASE_S=60
PAP_JOB_MAX_ATTEMPTS=3
# Worker /metrics port (job durations, engine invocations and failures); unset = not served
PAP_WORKER_METRICS_PORT=

# Observability (OBS-001). Logs are JSON on stderr. API /metrics is open outside production; in production it is
# served only with this bearer token. Traces go over OTLP/HTTP only when the endpoint is set.
PAP_METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
