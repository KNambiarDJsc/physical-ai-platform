       Orientation: board flat, component side up, pin 1 at the front-left corner;
       sensor X -> base -y, Y -> +x, Z -> +z, so yaw -90 deg (datasheet axis check
       by Evans, CAD check 2026-10-16). imu_link is the sensor frame; the firmware
       publishes in it and must not remap the axes as well.
       Was (0.0544, 0, 0.133) rpy 0 (16 Oct; 177 mm was measured against a
       displaced base plate) and (0.195, 0, -0.044) (Alex decision 2026-10-12). -->
  <!-- Visual: ICM-42688-P package (2.5 x 3.0 x 0.91 mm) on a board envelope with the
       outline of the MIKROE-4237 instance in the STEP (EV_ICM-42688-P outline not modelled),
       envelope in meshes/visual/imu.stl -->
  <link name="imu_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://openamrobot_description/meshes/visual/imu.stl"/>
      </geometry>
      <material name="imu_board"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="0.0544 0 0.1210"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  <!-- MB7060 -2XX compact housing envelope (datasheet 11838ab): 3/4 inch NPS section
         0.0262 x 0.0144 m and body 0.0347 x 0.0179 m behind the face, lock nut behind the
         panel; was a 0.031 m x 0.0385 m cylinder, superseded -->
  <link name="us_front_left">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://openamrobot_description/meshes/visual/ultrasonic.stl"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="us_front_left_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.3906 0.13 -0.0066"/>
    <parent link="base_link"/>
    <child link="us_front_left"/>
  </joint>
  <!-- MB7060 -2XX compact housing envelope (datasheet 11838ab): 3/4 inch NPS section
         0.0262 x 0.0144 m and body 0.0347 x 0.0179 m behind the face, lock nut behind the
         panel; was a 0.031 m x 0.0385 m cylinder, superseded -->
  <link name="us_front_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://openamrobot_description/meshes/visual/ultrasonic.stl"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="us_front_right_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.3906 -0.13 -0.0066"/>
    <parent link="base_link"/>
    <child link="us_front_right"/>
  </joint>
  <!-- MB7060 -2XX compact housing envelope (datasheet 11838ab): 3/4 inch NPS section
         0.0262 x 0.0144 m and body 0.0347 x 0.0179 m behind the face, lock nut behind the
         panel; was a 0.031 m x 0.0385 m cylinder, superseded -->
  <link name="us_rear_left">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://openamrobot_description/meshes/visual/ultrasonic.stl"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="us_rear_left_joint" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="-0.3886 0.13 -0.0066"/>
    <parent link="base_link"/>
    <child link="us_rear_left"/>
  </joint>
  <!-- MB7060 -2XX compact housing envelope (datasheet 11838ab): 3/4 inch NPS section
         0.0262 x 0.0144 m and body 0.0347 x 0.0179 m behind the face, lock nut behind the
         panel; was a 0.031 m x 0.0385 m cylinder, superseded -->
  <link name="us_rear_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://openamrobot_description/meshes/visual/ultrasonic.stl"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="us_rear_right_joint" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="-0.3886 -0.13 -0.0066"/>
    <parent link="base_link"/>
    <child link="us_rear_right"/>
  </joint>
  <!-- TF-Luna envelope, 0.035 x 0.02125 m, 0.0135 m deep behind the lens face (datasheet
         A05 and the STEP instance); was a 0.014 x 0.031 x 0.021 m box, superseded -->
  <link name="tof_front">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://openamrobot_description/meshes/visual/tof.stl"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="tof_front_joint" type="fixed">
    <origin rpy="0 0.174533 0" xyz="0.399 0 -0.0066"/>
    <parent link="base_link"/>
    <child link="tof_front"/>
  </joint>
  <!-- TF-Luna envelope, 0.035 x 0.02125 m, 0.0135 m deep behind the lens face (datasheet
         A05 and the STEP instance); was a 0.014 x 0.031 x 0.021 m box, superseded -->
  <link name="tof_rear">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://openamrobot_description/meshes/visual/tof.stl"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="tof_rear_joint" type="fixed">
    <origin rpy="0 0.174533 3.141592653589793" xyz="-0.399 0 -0.0066"/>
    <parent link="base_link"/>
    <child link="tof_rear"/>
  </joint>
  <gazebo reference="tof_front">
    <sensor name="tof_front_sensor" type="gpu_lidar">
      <pose relative_to="tof_front">0 0 0 0 0 0</pose>
      <topic>/tof/front</topic>
      <gz_frame_id>tof_front</gz_frame_id>
      <update_rate>50</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>3</samples>
            <resolution>1</resolution>
            <min_angle>-0.0175</min_angle>
            <max_angle>0.0175</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  <gazebo reference="tof_rear">
    <sensor name="tof_rear_sensor" type="gpu_lidar">
      <pose relative_to="tof_rear">0 0 0 0 0 0</pose>
      <topic>/tof/rear</topic>
      <gz_frame_id>tof_rear</gz_frame_id>
      <update_rate>50</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>3</samples>
            <resolution>1</resolution>
            <min_angle>-0.0175</min_angle>
            <max_angle>0.0175</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  <gazebo reference="us_front_left">
    <sensor name="us_front_left_sensor" type="gpu_lidar">
      <pose relative_to="us_front_left">0 0 0 0 0 0</pose>
      <topic>/ultrasonic/front_left</topic>
      <gz_frame_id>us_front_left</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>9</samples>
            <resolution>1</resolution>
            <min_angle>-0.17</min_angle>
            <max_angle>0.17</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>7.65</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  <gazebo reference="us_front_right">
    <sensor name="us_front_right_sensor" type="gpu_lidar">
      <pose relative_to="us_front_right">0 0 0 0 0 0</pose>
      <topic>/ultrasonic/front_right</topic>
      <gz_frame_id>us_front_right</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>9</samples>
            <resolution>1</resolution>
            <min_angle>-0.17</min_angle>
            <max_angle>0.17</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>7.65</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  <gazebo reference="us_rear_left">
    <sensor name="us_rear_left_sensor" type="gpu_lidar">
      <pose relative_to="us_rear_left">0 0 0 0 0 0</pose>
      <topic>/ultrasonic/rear_left</topic>
      <gz_frame_id>us_rear_left</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>9</samples>
            <resolution>1</resolution>
            <min_angle>-0.17</min_angle>
            <max_angle>0.17</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>7.65</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  <gazebo reference="us_rear_right">
    <sensor name="us_rear_right_sensor" type="gpu_lidar">
      <pose relative_to="us_rear_right">0 0 0 0 0 0</pose>
      <topic>/ultrasonic/rear_right</topic>
      <gz_frame_id>us_rear_right</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>9</samples>
            <resolution>1</resolution>
            <min_angle>-0.17</min_angle>
            <max_angle>0.17</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>7.65</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  <!-- ── World-level plugins (no reference attribute) ─────────────── -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- wheel separation: track 0.400 m is a placeholder from the 2023 STEP and the general arrangement; decisions.yaml DRIVE-TRACK is open and the 2.0 wheel assembly will change it; Gate A unit measured 0.46 m (2026-06-19).
           Was 0.4075, superseded by Alex decision 2026-10-12 -->
      <wheel_separation>0.400</wheel_separation>
      <!-- wheel radius 0.100 (Alex decision 2026-10-12, STEP MMP.00.00.00.000);
           was 0.11, superseded by Alex decision 2026-10-12 -->
      <wheel_radius>0.100</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
      <min_angular_acceleration>-1.0</min_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <frame_id>odom</frame_id>
      <!-- odom child is the URDF root base_footprint (REP 105, Alex decision
           2026-10-12), so base_link keeps a single parent; was base_link,
           superseded by Alex decision 2026-10-12 -->
      <child_frame_id>base_footprint</child_frame_id>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  <!-- ── Link-level: base_link ─────────────────────────────────────── -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
    <gravity>true</gravity>
    <surface>
      <friction>
        <ode>
          <mu>0.2</mu>
          <mu2>0.2</mu2>
        </ode>
      </friction>
      <contact>
        <ode>
          <kp>1e6</kp>
          <kd>100</kd>
        </ode>
      </contact>
    </surface>
  </gazebo>
  <!-- ── Link-level: left_wheel_link ────────────────────────────────────── -->
  <gazebo reference="left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <!-- ── Link-level: right_wheel_link ───────────────────────────────────── -->
  <gazebo reference="right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="fl_caster_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="fl_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="fr_caster_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="fr_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="bl_caster_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="bl_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="br_caster_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="br_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <!-- ── Link-level: camera_link — forward-facing RGB camera ──────── -->
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="camera_sensor" type="camera">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <topic>/rgb_image</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <update_rate>12</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  <!-- ── Link-level: imu_link — simulated IMU (from #69) ─────────────── -->
  <!-- Publishes gz topic "imu", which config/gz_bridge.yaml bridges to /imu.
       The sensor sits on imu_link with no pose offset; the frame (sensor axes,
       yaw -90 deg) is declared in sensors.xacro. The rate matches the 0.02 s
       nominal period in openamrobot_nav2 navigation_status_profile.yaml. No noise
       model: simulation only, not the ICM-42688-P's characteristics. -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <pose relative_to="imu_link">0 0 0 0 0 0</pose>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  <!-- The IMU system updates every imu sensor; neither walled_world.sdf nor
       a world that composes this model loads it, so the model does. -->
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>
  <!-- ── Link-level: lidar_link — sensor ONLY here ─────────────────── -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.40</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
</robot>
